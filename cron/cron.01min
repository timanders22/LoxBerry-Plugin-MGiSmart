#!/bin/sh
# MG iSmart - liest jede Minute die Werte des SAIC-MQTT-Gateways ein.
#
# Den bin-Pfad und den Log-Pfad <home>/.../plugins/<ordner> setzt der
# Installer in den Befehlszeilen ein.
#
# WARUM bin/ UND NICHT webfrontend/html/
# Bis 1.0.2 stand hier <HTML-Ordner des Plugins>/cron.php - das Skript lag also im
# UNANGEMELDETEN Webordner und war damit fuer jeden erreichbar, der die
# LoxBerry-Oberflaeche im Netz sieht:
#     http://loxberry/plugins/mgismart/cron.php
# Jeder Aufruf startet mosquitto_sub mit -W 3, haelt also drei Sekunden lang
# einen PHP-Arbeiter fest. Das war ein unbeabsichtigter, unauthentifizierter
# Endpunkt, den niemand brauchte: Der Cron ruft das Skript ueber das
# Dateisystem auf, nicht ueber HTTP.
#
# DIE FEHLERAUSGABE GEHT NACH cron.err (Hausstandard, Regeln/06; Bauform
# Docker NG 1.3.7). LoxBerry ruft jede Cron-Datei mit "> /dev/null 2>&1" auf
# (/etc/cron.d/lbdefaults). Bis 1.1.17 stand hier zusaetzlich ">/dev/null 2>&1"
# am php-Aufruf: fehlte die Bibliothek, endete der Takt mit rc 1 und
# "mg_lib.php nicht gefunden", und davon blieb nirgends eine Spur (Befund I3).
# Das Verzeichnis wird vorher angelegt, sonst scheitert schon die Umlenkung;
# touch frischt die Aenderungszeit auf (ein Anhaengen ohne Inhalt tut das
# nicht, gemessen am Abfahrts-Assistenten 1.6.9); ueber 256 kB bleiben die
# letzten 300 Zeilen - log/ liegt im Arbeitsspeicher. Der Reiter Logdateien
# zeigt die Datei, sobald etwas darin steht.
LOGV="REPLACELBPLOGDIR"
ERR="$LOGV/cron.err"
mkdir -p "$LOGV" 2>/dev/null
touch "$ERR" 2>/dev/null
# 1.1.31 (in WSL gemessen, vb_s1b_mg_skripte/s1b_probe_cron.sh): bis 1.1.30 brach die Umlenkung 2>>"$ERR" den Befehl ab, BEVOR php
# startete, wenn cron.err nicht schreibbar war - kein Takt, keine Spur. touch schuetzt nicht: es gelingt als Eigentuemer auf 0444 und
# auf einem Verzeichnis. Dann geht die Fehlerausgabe nach /dev/null, und der Takt laeuft.
( : >>"$ERR" ) 2>/dev/null || ERR=/dev/null
if [ -f "$ERR" ] && [ "$(stat -c %s "$ERR" 2>/dev/null || echo 0)" -gt 262144 ]; then
  tail -n 300 "$ERR" > "$ERR.neu" 2>/dev/null && mv -f "$ERR.neu" "$ERR"
fi
if [ ! -f REPLACELBPBINDIR/cron.php ]; then
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] cron.01min: REPLACELBPBINDIR/cron.php fehlt - Plugin neu installieren." >> "$ERR"
  exit 1
fi
# Gruppe 39 (1.1.28, V5/T3-2): nur EIN Minutenlauf zugleich. Holt cron nach dem
# Boot Minuten nach, starten zwei Laeufe in derselben Sekunde (Gedaechtnis "Cron
# holt Minuten nach"); der zweite endet still. Die Sperre steht hier in der
# Schale, nicht in cron.php (Gedaechtnis "Sperre vererbt sich an Kinder"): die
# Kinder, die laenger leben als der Lauf - der abgekoppelte Leser und die
# Befehlsbruecke -, schliessen jeden geerbten Deskriptor ueber 2 selbst.
# 1.1.31: die Sperre laesst sich nicht oeffnen - bis 1.1.30 still zu Ende, der Takt stand ohne Spur. Vorab in einer Unterschale gefragt:
# dash beendet das Skript schon am misslungenen exec, ein "|| ..." dahinter kaeme nie dran. Eine Zeile ins Protokoll, nur in Minute 00
# (je Minute waeren es 1440 am Tag auf der Ramdisk).
if ! ( : >>"$LOGV/cron.lock" ) 2>/dev/null; then
  [ "$(date +%M)" = 00 ] && ( echo "[$(date '+%Y-%m-%d %H:%M:%S')] FEHLER: Sperrdatei $LOGV/cron.lock nicht zu oeffnen - der Minutenlauf laeuft nicht. Rechte und freien Platz pruefen." >>"$LOGV/mg.log" ) 2>/dev/null
  exit 1
fi
exec 9>"$LOGV/cron.lock" || exit 0
flock -n 9 || exit 0
/usr/bin/php REPLACELBPBINDIR/cron.php >/dev/null 2>>"$ERR"
