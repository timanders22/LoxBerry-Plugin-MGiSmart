#!/bin/bash
# MG iSmart - uninstall
# command <TEMPFOLDER> <NAME> <FOLDER> <VERSION> <BASEFOLDER>
#
# Wird von LoxBerry als root ausgefuehrt. Rueckgabewert 0 = in Ordnung,
# 1 = Warnung (die Deinstallation laeuft trotzdem weiter).
#
# ===================================================================
# WARUM ES DIESE DATEI GIBT
# ===================================================================
#
# LoxBerry raeumt die Plugin-Ordner weg und entfernt den Cron-Eintrag.
# Drei Dinge bleiben sonst liegen, und alle drei sind Zugangsdaten oder
# Verweise darauf:
#
#   1. config/plugins/<ordner>.backup.json
#      Die Sicherung liegt bewusst NEBEN dem Konfigordner, damit sie
#      Update und Neuinstallation uebersteht (mg_paths()['backup']).
#      Beim Deinstallieren ist genau das falsch: darin stehen das
#      Broker-Passwort und das Merkwort des unangemeldeten Endpunkts.
#   2. /tmp/mgismart
#      Zwischenspeicher: letzter Zustand je Fahrzeug, Meldungen, Push-Test,
#      die Merkdatei der Drosselung und der Automatiken. /tmp ist auf dem
#      LoxBerry eine Ramdisk, der Ordner verschwindet also spaetestens beim
#      naechsten Neustart - bis dahin stuende er da.
#   3. Ein noch laufender mosquitto_sub aus einem Cron-Durchgang.
#   4. Die zurueckbehaltenen Themen der eigenen MQTT-Veroeffentlichung
#      (<mqtt_praefix>/<n>/...) im Broker - bis 1.1.16 blieben sie stehen,
#      und der Broker lieferte sie nach jedem Neustart des MQTT-Gateways an
#      den Miniserver (Pruefung-MGiSmart-1.1.17, Fall U1).
#
# ZUR PROZESSSUCHE: "pkill -f mosquitto_sub" waere grob falsch - so heissen
# die Aufrufe mehrerer Plugins und moeglicherweise laufende Sitzungen des
# Anwenders. Beendet wird nur, was DIESES Plugin gestartet hat - siehe
# mg_eigener_abruf() weiter unten.

PDIR=$3
[ -n "$PDIR" ] || PDIR="mgismart"
case "$PDIR" in
    .|..|*/*) echo "<WARNING> Unbrauchbarer Ordnername '$PDIR' - nichts entfernt."; exit 1 ;;
esac
# Dritter Rueckfall: der eigene Ablageort. Bewusst kein fest verdrahteter
# Systempfad - LoxBerry laesst sich anderswohin installieren, und der
# Plugin-Pruefer sucht die Zeichenkette, ohne den Zusammenhang zu sehen.
# Der Installer legt dieses Skript als <home>/data/system/uninstall/<ordner>
# ab und uebergibt die LoxBerry-Wurzel als fuenftes Argument
# (plugininstall.pl:1158 und :1577, am Geraet nachgesehen 17.09.2026);
# dieser Zweig greift nur, wenn beides fehlt.
#
# Wurzel ist, was config/plugins, data/plugins UND config/system/general.json
# traegt (Regeln/06). Bis 1.1.14 wurden hier drei Ebenen hinauf gerechnet und
# nichts geprueft: gemessen am 18.09.2026 in WSL (Pruefung-MGiSmart-1.1.14,
# Fall U1) loeschte das Skript, drei Ebenen unter einem fremden Baum ohne
# general.json abgelegt, dessen mgismart.backup.json und meldete Erfolg.
# Ohne brauchbare Wurzel wird jetzt nichts entfernt.
#
# Seit 1.1.17 gilt dieselbe Bedingung auch fuer $5 und $LBHOMEDIR: bis 1.1.16
# genuegte dort "-d", und ein fremder Baum ohne general.json als $5 verlor
# seine mgismart.backup.json (in WSL gemessen, Pruefung-MGiSmart-1.1.17,
# Fall U5).
mg_ist_wurzel() {
    [ -n "$1" ] && [ -d "$1/config/plugins" ] && [ -d "$1/data/plugins" ] \
        && [ -f "$1/config/system/general.json" ]
}
lb_wurzel_suchen() {
    v=$(cd "$(dirname "$(readlink -f "$0")")" 2>/dev/null && pwd)
    i=0
    while [ -n "$v" ] && [ "$v" != "/" ] && [ $i -lt 8 ]; do
        if mg_ist_wurzel "$v"; then
            echo "$v"; return 0
        fi
        v=$(dirname "$v"); i=$((i + 1))
    done
    return 1
}
BASE=""
if [ -n "$5" ] && ! mg_ist_wurzel "$5"; then
    echo "<WARNING> Das fuenfte Argument ($5) ist keine LoxBerry-Wurzel - es wird nicht benutzt."
fi
for MG_K in "$5" "$LBHOMEDIR"; do
    if mg_ist_wurzel "$MG_K"; then BASE="$MG_K"; break; fi
done
[ -n "$BASE" ] || BASE=$(lb_wurzel_suchen)
if [ -z "$BASE" ]; then
    echo "<WARNING> Das LoxBerry-Wurzelverzeichnis liess sich nicht bestimmen - nichts entfernt."
    echo "<WARNING> Liegen bleiben kann config/plugins/$PDIR.backup.json mit Broker-Passwort und Merkwort."
    exit 1
fi

PCONFIG="$BASE/config/plugins/$PDIR"
PDATA="$BASE/data/plugins/$PDIR"
BK="$BASE/config/plugins/$PDIR.backup.json"
TMP="/tmp/$PDIR"

# Das Themenpraefix steht in der Konfiguration; ohne es wird kein Prozess
# angefasst.
PREFIX=""
if [ -r "$PCONFIG/mg.json" ] && command -v python3 >/dev/null 2>&1; then
    PREFIX=$(python3 -c 'import json,sys
try:
    print(str(json.load(open(sys.argv[1])).get("prefix") or ""))
except Exception:
    print("")' "$PCONFIG/mg.json" 2>/dev/null)
fi
[ -n "$PREFIX" ] || PREFIX="saic"

# Ein Abruf DIESES Plugins, argumentweise ueber /proc (Regeln/06): argv[0]
# heisst mosquitto_sub, ein Argument ist genau "<prefix>/#", der Prozess
# gehoert dem Dienstbenutzer (loxberry, ohne ihn der eigenen Kennung), und er
# liest seine Zugangsdaten aus DIESEM Datenordner (XDG_CONFIG_HOME, so setzt
# es mg_broker_umgebung()). Bis 1.1.16 genuegten argv[0] und das Argument:
# ein mosquitto_sub des Anwenders auf denselben Baum wurde beendet, und nach
# der Warteschleife ging "kill -9" ohne neue Pruefung an die Nummer - auch
# wenn sie inzwischen zu einem anderen Prozess gehoerte (in WSL gemessen,
# Pruefung-MGiSmart-1.1.17, Faelle U3b, U3c). Jetzt vor JEDEM Signal pruefen,
# kein "kill -0".
MG_UID=$(id -u loxberry 2>/dev/null || id -u)
MG_XDG=$(readlink -f "$PDATA/mosquitto" 2>/dev/null)
mg_eigener_abruf() {   # $1 PID
    d="/proc/$1"
    [ -r "$d/cmdline" ] || return 1
    a0=$( { tr '\0' '\n' < "$d/cmdline" | head -1; } 2>/dev/null)
    [ "$(basename -- "$a0" 2>/dev/null)" = "mosquitto_sub" ] || return 1
    { tr '\0' '\n' < "$d/cmdline" | grep -qxF -- "$PREFIX/#"; } 2>/dev/null || return 1
    u=$(awk '/^Uid:/ {print $2}' "$d/status" 2>/dev/null)
    [ -n "$u" ] && [ "$u" = "$MG_UID" ] || return 1
    x=$( { tr '\0' '\n' < "$d/environ" | sed -n 's/^XDG_CONFIG_HOME=//p' | head -1; } 2>/dev/null)
    [ -n "$x" ] && [ -n "$MG_XDG" ] && [ "$(readlink -f "$x" 2>/dev/null)" = "$MG_XDG" ] || return 1
    return 0
}
GEFUNDEN=0
for D in /proc/[0-9]*; do
    P=${D#/proc/}
    mg_eigener_abruf "$P" || continue
    GEFUNDEN=1
    kill "$P" 2>/dev/null
    for i in 1 2 3; do
        mg_eigener_abruf "$P" || break
        sleep 1
    done
    mg_eigener_abruf "$P" && kill -9 "$P" 2>/dev/null && sleep 1
    if mg_eigener_abruf "$P"; then
        echo "<WARNING> Der Abruf (PID $P) laeuft weiter."
    elif [ -d "/proc/$P" ]; then
        echo "<INFO> PID $P ist kein Abruf dieses Plugins mehr - nicht weiter angefasst."
    else
        echo "<OK> Laufenden mosquitto_sub beendet (PID $P)."
    fi
done
[ "$GEFUNDEN" -eq 0 ] && echo "<INFO> Es lief kein Abruf."

# Seit 1.1.18 (Entscheidung 7, Bauliste G7): den Gateway-Container, den DIESES
# Plugin angelegt hat, entfernen. Gesucht per Label, gegengeprueft per inspect
# auf beide Labels (Ordner und Name) - nie nach dem Namen allein. Ein Container
# gleichen Namens ohne Label (von Hand betrieben) bleibt, ebenso das Abbild.
# Jeder docker-Aufruf mit timeout. <OK> erst, wenn der Container fort ist.
MG_RC=0
MG_GW_WEG=0
MG_GWNAME="lb-$PDIR-saic-gateway"
MG_GWBILD="saicismartapi/saic-python-mqtt-gateway"
MG_HAND="docker ps -a --filter label=de.loxberry.plugin.folder=$PDIR, dann docker rm -f <Kennung>"
mg_gw_labels() {   # $1 Kennung -> "<ordner> <name>" der beiden Labels
    timeout 30 docker inspect --type container \
        --format '{{index .Config.Labels "de.loxberry.plugin.folder"}} {{index .Config.Labels "de.loxberry.plugin.name"}}' \
        "$1" 2>/dev/null
}
# Die Merkdatei (Nacharbeit 30.09., N1): liegt sie (oder ihre .alt-Ablage
# aus preinstall.sh), hat dieses Plugin einmal einen Container angelegt. Nur
# dann ist ein fehlendes oder stummes docker eine Warnung; sonst hat der
# Anwender den Gateway-Knopf nie benutzt, und es gibt nichts zu entfernen.
# Gesucht wird mit docker trotzdem immer per Label, unabhaengig von ihr.
MG_MERK="$BASE/config/plugins/$PDIR.gateway_angelegt"
MG_MERK_DA=0
{ [ -e "$MG_MERK" ] || [ -e "$MG_MERK.alt" ]; } && MG_MERK_DA=1
MG_DOCKER_WEG=""
if ! command -v docker >/dev/null 2>&1 || ! command -v timeout >/dev/null 2>&1; then
    MG_DOCKER_WEG="docker ist nicht aufzurufen"
elif ! timeout 10 docker info --format '{{.ServerVersion}}' >/dev/null 2>&1; then
    MG_DOCKER_WEG="Docker antwortet nicht (docker info)"
fi
if [ -n "$MG_DOCKER_WEG" ] && [ "$MG_MERK_DA" = 1 ]; then
    echo "<WARNING> $MG_DOCKER_WEG - der Gateway-Container, den dieses Plugin angelegt hat, wurde nicht entfernt. Von Hand: $MG_HAND"
    MG_RC=1
elif [ -n "$MG_DOCKER_WEG" ]; then
    echo "<INFO> Kein Gateway-Container von diesem Plugin angelegt ($MG_DOCKER_WEG) - nichts zu entfernen."
else
    MG_IDS=$(timeout 30 docker ps -a -q --no-trunc --filter "label=de.loxberry.plugin.folder=$PDIR" 2>/dev/null)
    MG_PSRC=$?
    if [ "$MG_PSRC" != 0 ]; then
        echo "<WARNING> Die Suche nach dem Gateway-Container scheiterte (rc=$MG_PSRC). Von Hand: $MG_HAND"
        MG_RC=1
    fi
    MG_EIGENE=0
    for MG_ID in $MG_IDS; do
        case "$MG_ID" in
            *[!0-9a-f]*) continue ;;
        esac
        MG_KURZ=$(printf '%.12s' "$MG_ID")
        if [ "$(mg_gw_labels "$MG_ID")" != "$PDIR mgismart" ]; then
            echo "<INFO> Container $MG_KURZ traegt nicht beide Labels dieses Plugins - nicht angefasst."
            continue
        fi
        MG_EIGENE=$((MG_EIGENE + 1))
        timeout 60 docker stop -t 20 "$MG_ID" >/dev/null 2>&1
        timeout 30 docker rm "$MG_ID" >/dev/null 2>&1
        MG_NOCH=$(timeout 30 docker ps -a -q --no-trunc --filter "id=$MG_ID" 2>/dev/null)
        MG_NRC=$?
        if [ "$MG_NRC" = 0 ] && [ -z "$MG_NOCH" ]; then
            echo "<OK> Gateway-Container $MG_KURZ entfernt."
            MG_GW_WEG=1
        elif [ "$MG_NRC" != 0 ]; then
            echo "<WARNING> Ob der Gateway-Container $MG_KURZ fort ist, liess sich nicht nachsehen (rc=$MG_NRC). Von Hand: docker rm -f $MG_KURZ"
            MG_RC=1
        else
            echo "<WARNING> Der Gateway-Container $MG_KURZ liess sich nicht entfernen. Von Hand: docker rm -f $MG_KURZ"
            MG_RC=1
        fi
    done
    [ "$MG_EIGENE" -eq 0 ] && [ "$MG_PSRC" = 0 ] && echo "<INFO> Es gab keinen Gateway-Container dieses Plugins."
    if timeout 30 docker inspect --type container --format '{{.Id}}' "$MG_GWNAME" >/dev/null 2>&1 \
       && [ "$(mg_gw_labels "$MG_GWNAME")" != "$PDIR mgismart" ]; then
        echo "<INFO> Ein Container namens $MG_GWNAME ohne die Labels dieses Plugins bleibt unberuehrt."
    fi
    echo "<INFO> Das Abbild $MG_GWBILD bleibt (es kann von anderen genutzt werden). Von Hand: docker image rm $MG_GWBILD"
fi

# Erst NACH einem entfernten eigenen Container: die zurueckbehaltenen Themen
# des Gateways unter <prefix>/ (bin/cron.php --gateway-leeren, mit Bestaetigung
# durch den Broker; Vorgabe aus Frage 5). Ohne entfernten Container stammen sie
# von einem Gateway, das dieses Plugin nicht angelegt hat - sie bleiben.
MG_CRON="$BASE/bin/plugins/$PDIR/cron.php"
if [ "$MG_GW_WEG" = 1 ]; then
    if command -v php >/dev/null 2>&1 && [ -f "$MG_CRON" ] \
       && { [ -r "$PCONFIG/mg.json" ] || [ -r "$BK" ]; }; then
        if [ "$(id -u)" = "0" ] && id loxberry >/dev/null 2>&1; then
            su -s /bin/bash loxberry -c "$(printf '%q ' env "LBHOMEDIR=$BASE" "LBPPLUGINDIR=$PDIR" \
                timeout 90 php "$MG_CRON" --gateway-leeren)" < /dev/null 2>&1
        else
            env "LBHOMEDIR=$BASE" "LBPPLUGINDIR=$PDIR" timeout 90 php "$MG_CRON" --gateway-leeren \
                < /dev/null 2>&1
        fi
    else
        echo "<INFO> PHP, cron.php oder die Konfiguration fehlt - die Themen des Gateways wurden nicht geleert."
    fi
fi

# Die zurueckbehaltenen MQTT-Themen dieses Plugins abraeumen: bin/cron.php
# --mqtt-leeren fragt den Broker, leert und liest nach (mg_mqtt_leeren() in
# mg_lib.php). Wurzel und Ordner werden ausdruecklich genannt, sonst hielte
# sich die Bibliothek fuer ein Archiv. Als loxberry, wie der Minutentakt.
if command -v php >/dev/null 2>&1 && [ -f "$MG_CRON" ] \
   && { [ -r "$PCONFIG/mg.json" ] || [ -r "$BK" ]; }; then
    if [ "$(id -u)" = "0" ] && id loxberry >/dev/null 2>&1; then
        su -s /bin/bash loxberry -c "$(printf '%q ' env "LBHOMEDIR=$BASE" "LBPPLUGINDIR=$PDIR" \
            timeout 90 php "$MG_CRON" --mqtt-leeren)" < /dev/null 2>&1
    else
        env "LBHOMEDIR=$BASE" "LBPPLUGINDIR=$PDIR" timeout 90 php "$MG_CRON" --mqtt-leeren \
            < /dev/null 2>&1
    fi
else
    echo "<INFO> PHP, cron.php oder die Konfiguration fehlt - zurueckbehaltene MQTT-Themen wurden nicht geleert."
fi

# Die Zweitschrift UND ihr beiseitegelegter Stand: mg_kaputt_beiseite()
# (mg_lib.php) legt eine beschaedigte Zweitschrift als
# <ordner>.backup.json.kaputt daneben - ausserhalb des Plugin-Ordners, also
# raeumt LoxBerry sie nicht weg. Bis 1.1.14 blieb sie liegen, und das Skript
# meldete trotzdem, Broker-Passwort und Merkwort seien fort; ebenso, wenn rm
# scheiterte (gemessen 18.09.2026 in WSL, Pruefung-MGiSmart-1.1.14, Faelle
# U3/U4). Gemeldet wird jetzt, was nachgesehen wurde.
# Seit 1.1.18 (Bauliste I1/I2): auch die .alt-Ablagen von preinstall.sh und
# die Nebendateien eines abgebrochenen mg_write_atomic() auf die Zweitschrift
# (<datei>.<pid>.<zufall>.tmp) - sie tragen dasselbe. Die Schlussmeldung
# steht erst NACH dieser Zaehlung.
MG_ENTFERNT=0; MG_BLEIBT=0
for MG_F in "$BK" "$BK.kaputt" "$BK.alt" "$BK.kaputt.alt" "$BK".*.tmp; do
    [ -e "$MG_F" ] || continue
    rm -f "$MG_F" 2>/dev/null
    if [ -e "$MG_F" ]; then
        MG_BLEIBT=$((MG_BLEIBT + 1))
        echo "<WARNING> Liess sich nicht entfernen: $MG_F"
    else
        MG_ENTFERNT=$((MG_ENTFERNT + 1))
        echo "<OK> Entfernt: $(basename "$MG_F")"
    fi
done
if [ "$MG_BLEIBT" -gt 0 ]; then
    echo "<WARNING> Darin stehen Broker-Passwort und Merkwort - bitte von Hand entfernen."
elif [ "$MG_ENTFERNT" -gt 0 ]; then
    echo "<INFO> Broker-Passwort und Merkwort sind damit vom LoxBerry fort."
else
    echo "<INFO> Keine Sicherung ausserhalb des Plugin-Ordners vorhanden."
fi

# Die Optionsdateien mit den Broker-Zugangsdaten. Der Datenordner wird von
# LoxBerry ohnehin entfernt; sollte das fehlschlagen, waeren hier Zugangsdaten
# zurueckgeblieben - deshalb ausdruecklich.
if [ -d "$PDATA/mosquitto" ]; then
    rm -rf "$PDATA/mosquitto" && echo "<OK> Zugangsdaten fuer mosquitto entfernt."
fi

if [ -d "$TMP" ]; then
    rm -rf "$TMP" && echo "<OK> Zwischenspeicher $TMP entfernt."
fi

# Die Merker neben dem Datenordner (seit 1.1.18): die Upgrade-Marke
# (Entscheidung 1) und die Kennung eines liegengebliebenen Containers (G8).
# Dazu die Merkdatei des angelegten Containers samt .alt (N1) - abgeraeumt
# erst hier, nachdem oben entschieden wurde; jede Datei wird nachgesehen.
for MG_F in "$BASE/data/plugins/$PDIR.upgrade_laeuft" "$BASE/data/plugins/$PDIR.gateway_frueher"             "$MG_MERK" "$MG_MERK.alt"; do
    [ -e "$MG_F" ] || continue
    rm -f "$MG_F" 2>/dev/null
    if [ -e "$MG_F" ]; then
        echo "<WARNING> Liess sich nicht entfernen: $MG_F"
    else
        echo "<OK> Entfernt: $(basename "$MG_F")"
    fi
done

# Der Schlusstext haengt davon ab, was oben geschah (Bauliste G7 Schritt 7):
# bis 1.1.17 hiess es pauschal, der Container stamme nicht von diesem Plugin.
if [ "$MG_GW_WEG" = 1 ]; then
    echo "<INFO> Zurueckbehaltene Themen unter einem FRUEHER eingestellten eigenen Praefix"
    echo "<INFO> raeumt dieses Skript nicht ab. Nachsehen: mosquitto_sub -t '<praefix>/#' --retained-only"
else
    echo "<INFO> Ein von Hand betriebenes SAIC-MQTT-Gateway (ohne die Labels dieses Plugins)"
    echo "<INFO> bleibt unberuehrt, ebenso seine Themen ($PREFIX/...) im Broker."
    echo "<INFO> Zurueckbehaltene Themen unter einem FRUEHER eingestellten eigenen Praefix"
    echo "<INFO> raeumt dieses Skript nicht ab. Nachsehen: mosquitto_sub -t '<praefix>/#' --retained-only"
fi
exit $MG_RC
